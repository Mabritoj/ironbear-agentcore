{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@shared-types": ["./shared-types/index.ts"] }
  },
  "include": ["handlers/**/*", "layers/**/src/**/*", "shared-types/**/*"]
}
