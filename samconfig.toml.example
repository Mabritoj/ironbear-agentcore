version = 0.1

# Copy to samconfig.toml (gitignored) and fill in the placeholders.
[default]
[default.deploy.parameters]
stack_name = "ironbear-agentcore"
s3_prefix = "ironbear-agentcore"
s3_bucket = "<deployment-bucket-name>"
capabilities = "CAPABILITY_IAM CAPABILITY_NAMED_IAM"
parameter_overrides = [
  "GatewayName=<gateway-name>",
  "CognitoDiscoveryUrl=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/openid-configuration",
  "CognitoClientId=<cognito-app-client-id>",
  "PolicyEngineMode=LOG_ONLY",
  "LogRetentionInDays=30",
]
tags = [
  "BACKUP=ironbear-agentcore",
]
